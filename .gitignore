# ==========================================
# SilverAI - Git Ignore
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*.so
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Python tools
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Trained models and ML artifacts
saved_models/
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.onnx
*.pt
*.pth

# Datasets - keep directory, ignore its contents
data/*
!data/.gitkeep

# Node.js dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Frontend build outputs
dist/
build/
frontend/dist/
frontend/build/

# Node.js caches
.npm/
.eslintcache/
.vite/
.turbo/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak

# Reports
# Keep research reports, evaluation results, figures and final documentation.
# Ignore only temporary/log files.
reports/**/*.tmp
reports/**/*.log